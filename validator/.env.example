# validator-service configuration. Every variable is prefixed VALIDATOR_.
# Copy to .env for local runs. No secrets are involved: this service holds no
# credentials of its own and authenticates nobody.

# TCP port the service binds to.
VALIDATOR_PORT=8000

# How many prepared static GTFS feeds the cache holds at once. Each entry
# peaks at about 584 MB resident for an MBTA-sized archive (18 MB, 92,360
# trips), so raising this multiplies memory, not just cache hits. A node serves
# one agency and carries one static_gtfs_ref, so 1 is the normal case and the
# default that must not surprise anyone.
#
# That figure is measured on the pinned gtfs-rt-validator 0.3.0, on that
# archive, on 2026-08-16. It was about 3.5 GB on 0.2.0, so the number tracks
# the pin in pyproject.toml and is not a property of the archive alone. The
# chart's memory request is derived from it.
VALIDATOR_CACHE_SIZE=1

# Seconds a prepared feed is trusted before the next request against its URL
# triggers a rebuild. The package never re-reads a static archive on its own
# once prepared: an agency publishes to a stable URL whose CONTENTS change, so
# this TTL is the only thing that will ever notice. Conservative relative to
# both the ~48 second rebuild cost (a 75x safety margin) and typical
# static-schedule change cadence (service changes are a daily event, not a
# minute-to-minute one).
VALIDATOR_CACHE_TTL_SECONDS=3600

# Seconds to wait for the static GTFS archive to download before giving up and
# answering 502. Realtime message fetches are not covered by this: the service
# never fetches a realtime feed itself, only the multipart bytes the caller
# already sent.
VALIDATOR_STATIC_FETCH_TIMEOUT_SECONDS=60
