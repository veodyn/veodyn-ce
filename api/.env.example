# veodyn-api configuration. Every variable is prefixed VEODYN_.
# Copy to .env for local runs. Never commit a filled-in .env.

# The Redash this service authenticates against and delegates query execution
# to. Inside docker compose this is the in-network address (http://server:5000),
# not localhost.
VEODYN_REDASH_URL=http://localhost:5001

# A dedicated Redash service account's USER API key (Redash: Settings ->
# Account -> API Key). The worker has no caller to borrow credentials from, so
# scheduled evaluations run as this account.
#
# Give it execute access to the data sources behind KPI source queries and
# nothing more. Do NOT use an admin's key: a leak of this value would then be a
# full-instance compromise rather than read access to some queries.
VEODYN_REDASH_SERVICE_API_KEY=

# Its own database, not Redash's. The local default is the Redash container's
# Postgres, which publishes host port 15432 with trust auth.
VEODYN_DATABASE_URL=postgresql+psycopg://postgres@localhost:15432/veodyn

# Shared with Redash in production, on a different database index. The local
# default uses index 5 because index 0 on the host belongs to another service.
VEODYN_REDIS_URL=redis://localhost:6379/5

# How long a resolved Redash session is trusted before it is re-checked.
VEODYN_SESSION_CACHE_TTL_SECONDS=30

# Ceiling on a synchronous "Recompute now". The UI is waiting on this request,
# so it cannot be generous.
VEODYN_RECOMPUTE_TIMEOUT_SECONDS=30

# Ceiling on a scheduled evaluation, which nobody is waiting on.
VEODYN_JOB_POLL_TIMEOUT_SECONDS=120

# Cap on the 2 ** failures minute backoff, mirroring Redash's own
# schedule_failures behaviour.
VEODYN_MAX_FAILURE_BACKOFF_MINUTES=60

# Ceiling on freezing a whole report. Snapshotting runs every query the document
# names and hands the frozen document back in the response, so the editor is
# waiting on it. One budget for the whole document rather than one per block: a
# report with ten data blocks would otherwise be allowed ten times this, and the
# author would be watching a spinner with no way to tell whether it was still
# legitimate.
VEODYN_REPORT_SNAPSHOT_TIMEOUT_SECONDS=120

# The containerized MobilityData GTFS-Realtime validator that published feeds
# are checked against before they publish. Empty means no validator is
# configured, and a publish attempt then fails rather than publishing bytes
# nothing has checked: an absent verdict is never read as a passing one.
VEODYN_FEED_VALIDATOR_URL=

# ─── The AI provider (/ai/*) ────────────────────────────────────────────────
# Both of the next two must be set or every /ai route answers 503. A
# half-configured instance must not become one with an open generation
# endpoint.

# The shared secret veodyn-de's AI relay presents as `Authorization: Bearer`.
# It is the ONLY credential on an /ai request: the relay strips the browser's
# cookie before calling out, because the configured provider may be a third
# party. Must equal the frontend's VEODYN_AI__KEY.
VEODYN_AI_RELAY_KEY=

# The Anthropic API key the provider generates with.
VEODYN_AI_API_KEY=
VEODYN_AI_BASE_URL=https://api.anthropic.com
VEODYN_AI_MODEL=claude-sonnet-5

# The digest is fetched on every Home render but changes on the cadence of KPI
# evaluation and warehouse capture, so it is cached in-process.
VEODYN_AI_DIGEST_CACHE_SECONDS=600

# How many real queries are put in front of the model as the set it may choose
# a report section's source from. Anything it names outside this set is dropped.
VEODYN_AI_MAX_GROUNDED_QUERIES=60
