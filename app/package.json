{
  "name": "veodyn-app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm gen:plugins && pnpm gen:features",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api-types": "cd ../api && uv run python -m veodyn_api.openapi > openapi.json && cd ../app && openapi-typescript ../api/openapi.json -o src/types/generated/veodyn-api.d.ts",
    "gen:plugins": "node scripts/generate-plugin-registry.mjs",
    "gen:features": "node scripts/generate-feature-registry.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test --config playwright.ai.config.ts",
    "screenshots:docs": "playwright test --config playwright.screenshots.config.ts",
    "validate:palette": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-palette.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.90.21",
    "@types/geojson": "^7946.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-cloud": "^1.2.9",
    "d3-hierarchy": "^3.1.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^4.7.1",
    "monaco-editor": "0.55.1",
    "next": "16.2.10",
    "posthog-js": "^1.409.5",
    "posthog-node": "^5.47.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.2",
    "react-map-gl": "^7.1.9",
    "react-resizable-panels": "4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.5",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "knip": "^6.32.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
